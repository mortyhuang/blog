---
import Icon from './Icon.astro';
---
<dialog class="search-dialog" id="search-dialog" aria-labelledby="search-title">
  <div class="search-input-wrap">
    <Icon name="search" size={23} />
    <label for="search-input" id="search-title" class="sr-only">搜索文章</label>
    <input id="search-input" type="search" placeholder="搜索文章、标签或灵感…" autocomplete="off" />
    <button class="search-close" data-search-close aria-label="关闭搜索"><kbd>ESC</kbd><Icon name="close" size={17} /></button>
  </div>
  <div class="search-body">
    <div class="search-status" id="search-status" role="status">从一个关键词开始探索</div>
    <div id="search-results"></div>
  </div>
  <div class="search-bottom"><span><kbd>↑</kbd><kbd>↓</kbd> 选择 <kbd>↵</kbd> 打开</span><span>在数字花园里寻找灵感 <Icon name="sparkle" size={13} /></span></div>
</dialog>
<script>
  import { initSearch } from '../scripts/search';
  initSearch();
</script>
