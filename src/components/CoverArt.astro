---
interface Props { kind?: 'terrain' | 'orbit' | 'grid' | 'gradient'; class?: string; label?: string; caption?: string; }
const { kind = 'terrain', class: className, label, caption } = Astro.props;
const lines = Array.from({ length: 45 }, (_, j) => {
  const y = j * 5 + 66;
  const points = Array.from({ length: 130 }, (_, i) => {
    const x = i * 4.6 - 20;
    const mountain = Math.exp(-Math.pow((x - 370) / 110, 2)) * 80 + Math.exp(-Math.pow((x - 170) / 90, 2)) * 60;
    const wave = Math.sin(x * .02 + j * .12) * 12;
    return `${i ? 'L' : 'M'}${x.toFixed(1)},${(y - mountain * Math.sin(j / 45 * Math.PI) + wave).toFixed(1)}`;
  }).join(' ');
  return points;
});
---
<div class:list={['cover-art', `cover-${kind}`, className]} aria-hidden="true">
  {kind === 'terrain' && <svg viewBox="0 0 560 260" preserveAspectRatio="xMidYMid slice">
    <defs><linearGradient id="terrain-bg" x2="1" y2="1"><stop stop-color="#dce8d5" /><stop offset="1" stop-color="#b6cfb5" /></linearGradient><linearGradient id="terrain-lines" x2=".9" y2=".8"><stop stop-color="#7b9c72" /><stop offset="1" stop-color="#396e48" /></linearGradient><radialGradient id="terrain-sun"><stop stop-color="#f4f2d1" /><stop offset="1" stop-color="#e3e8b6" /></radialGradient></defs>
    <rect width="560" height="260" fill="url(#terrain-bg)" />
    <circle cx="380" cy="75" r="45" fill="url(#terrain-sun)" opacity=".8" />
    <g fill="none" stroke="url(#terrain-lines)" stroke-width="1" opacity=".65">{lines.map((d) => <path d={d} />)}</g>
    {label && <text x="24" y="30" fill="#396e48" opacity=".65" font-size="9" letter-spacing="2" font-family="monospace">{label}</text>}
    <path d="M520 22v14m-7-7h14" stroke="#396e48" opacity=".5" />
    <text x="24" y="241" fill="#396e48" opacity=".75" font-size="9" font-family="monospace">{caption ?? 'x: 0.618 / y: 1.000 / t: ∞'}</text>
  </svg>}
  {kind === 'orbit' && <svg viewBox="0 0 560 260" preserveAspectRatio="xMidYMid slice">
    <defs><linearGradient id="orbit-bg" x2="1" y2="1"><stop stop-color="#e4e1f0" /><stop offset="1" stop-color="#c3c4dd" /></linearGradient><radialGradient id="orbit-sphere" cx=".35" cy=".2" r=".9"><stop stop-color="#f4f0ff" /><stop offset=".5" stop-color="#bcb4d4" /><stop offset="1" stop-color="#8a87b2" /></radialGradient></defs>
    <rect width="560" height="260" fill="url(#orbit-bg)" />
    <g stroke="#8b83aa" fill="none" opacity=".2"><path d="M0 65h560M0 130h560M0 195h560M70 0v260M140 0v260M210 0v260M280 0v260M350 0v260M420 0v260M490 0v260" /><circle cx="280" cy="130" r="101" /><circle cx="280" cy="130" r="116" stroke-dasharray="2 8" /></g>
    <circle cx="280" cy="130" r="67" fill="url(#orbit-sphere)" />
    <g fill="none" stroke="#77719b" stroke-width=".8" opacity=".65">{Array.from({ length: 22 }, (_, i) => <ellipse cx="280" cy="130" rx={15 + i * 4.2} ry={79 - i * 2.5} transform={`rotate(-32 280 130)`} />)}</g>
    <circle cx="369" cy="75" r="6" fill="#8d86a5" /><circle cx="182" cy="176" r="3" fill="#8d86a5" />
    {label && <text x="24" y="30" fill="#67617c" opacity=".75" font-size="9" letter-spacing="2" font-family="monospace">{label}</text>}
    <text x="24" y="241" fill="#67617c" opacity=".75" font-size="9" font-family="monospace">{caption ?? 'HTML FIRST / ASTRO ISLANDS'}</text>
    <path d="M520 22v14m-7-7h14" stroke="#77719b" opacity=".5" />
  </svg>}
  {kind === 'grid' && <svg viewBox="0 0 560 260" preserveAspectRatio="xMidYMid slice">
    <rect width="560" height="260" fill="#e4e9e2" />
    <g fill="none" stroke="#84967c" opacity=".4">{Array.from({ length: 14 }, (_, i) => <path d={`M${i * 45} 0v260M0 ${i * 25}h560`} />)}</g>
    <rect x="180" y="54" width="200" height="152" rx="5" fill="#f3f5eb" stroke="#84967c" />
    <path d="M180 85h200" stroke="#84967c" /><g fill="#9caf91"><circle cx="194" cy="70" r="3" /><circle cx="205" cy="70" r="3" /><circle cx="216" cy="70" r="3" /></g>
    <text x="214" y="150" fill="#4c6851" font-family="monospace" font-size="38">&lt; / &gt;</text>
    {label && <text x="24" y="30" fill="#516b52" opacity=".7" font-size="9" letter-spacing="2" font-family="monospace">{label}</text>}
  </svg>}
  {kind === 'gradient' && <svg viewBox="0 0 560 260" preserveAspectRatio="xMidYMid slice">
    <defs><linearGradient id="gradient-bg" x2="1" y2="1"><stop stop-color="#eee3d0" /><stop offset="1" stop-color="#debc9e" /></linearGradient></defs>
    <rect width="560" height="260" fill="url(#gradient-bg)" />
    <g fill="none" stroke="#a9825d" stroke-width="1" opacity=".5">{Array.from({ length: 24 }, (_, i) => <circle cx="280" cy="145" r={18 + i * 7} />)}</g>
    <path d="M279 62v168M196 145h168" stroke="#9b754e" opacity=".5" />
    {label && <text x="24" y="30" fill="#8b6748" opacity=".7" font-size="9" letter-spacing="2" font-family="monospace">{label}</text>}
  </svg>}
</div>
