---
/**
 * Bento 卡片网格日历：顶部三张实时概览卡（年度进度 / 近期假期 / 近期发薪）+
 * 主日历（当月双栏并排、全年 4×3 全宽展开）+ 倒计时与假期统计模块。
 * 首屏在构建时静态渲染，浏览器负责将「今天」相关的部分刷新到当前真实日期。
 */
import CalendarShareDialog from './CalendarShareDialog.astro';
import Icon from './Icon.astro';
import holidaysData from '../data/holidays.json';
import {
  buildDayFlags,
  dataYears,
  defaultHolidayStatsYear,
  getHolidayRows,
  getHolidayStats,
  getWageRows,
  getYearProgress,
  type HolidayData,
} from '../lib/holidays';
import {
  renderHolidayRows,
  renderHolidayStats,
  renderNextHolidayCard,
  renderNextWageCard,
  renderProgress,
  renderWageRows,
} from '../lib/calendar-view';
import { renderMonthView, renderMonths } from '../lib/lunar-calendar';

const data = holidaysData as HolidayData;
const years = dataYears(data);
const today = new Date();
const currentYear = today.getFullYear();
const firstYear = years[0] ?? currentYear;
const lastYear = years[years.length - 1] ?? currentYear;
const initialYear = Math.min(lastYear, Math.max(firstYear, currentYear));
const initialMonth = today.getMonth() + 1;
const flags = buildDayFlags(data);

const progress = getYearProgress(today, initialYear);
const wageRows = getWageRows(today, flags);
const holidayRows = getHolidayRows(today, data);
const initialStatsYear = defaultHolidayStatsYear(today, data);
const holidayStats = getHolidayStats(initialStatsYear, data, today);
---

<div
  class="holiday-calendar"
  data-holiday-calendar
  data-active-view="month"
  data-year={initialYear}
  data-month={initialMonth}
  data-year-first={firstYear}
  data-year-last={lastYear}
  data-current-year={currentYear}
>
  <section class="hc-panel hc-bento-kpi hc-bento-progress" aria-labelledby="hc-progress-title">
    <div class="hc-panel-head is-compact">
      <h2 id="hc-progress-title">年度进度</h2>
      <span class="hc-panel-meta mono"><span data-progress-year>{initialYear}</span></span>
    </div>
    <div class="hc-kpi-body" data-progress-output set:html={renderProgress(progress)} />
  </section>

  <section class="hc-panel hc-bento-kpi hc-bento-next-holiday" aria-labelledby="hc-next-holiday-title">
    <div class="hc-panel-head is-compact">
      <h2 id="hc-next-holiday-title">近期假期</h2>
      <span class="hc-panel-meta mono">HOLIDAY</span>
    </div>
    <div class="hc-kpi-body" data-next-holiday-output set:html={renderNextHolidayCard(holidayRows)} />
  </section>

  <section class="hc-panel hc-bento-kpi hc-bento-next-wage" aria-labelledby="hc-next-wage-title">
    <div class="hc-panel-head is-compact">
      <h2 id="hc-next-wage-title">近期发薪</h2>
      <span class="hc-panel-meta mono">PAYDAY</span>
    </div>
    <div class="hc-kpi-body" data-next-wage-output set:html={renderNextWageCard(wageRows)} />
  </section>

  <section class="hc-panel hc-bento-calendar" aria-labelledby="hc-calendar-title">
    <div class="hc-panel-head">
      <div class="hc-calendar-title-group">
        <h2 id="hc-calendar-title">月历</h2>
      </div>
      <div class="hc-panel-controls">
        <button type="button" class="hc-year-reset" data-year-reset data-at-now="true">回到本月</button>
        <div class="hc-view-switch" role="group" aria-label="切换视图" data-view-switch hidden>
          <button type="button" class="hc-view-button" data-view="year" aria-pressed="false">全年</button>
          <button type="button" class="hc-view-button" data-view="month" aria-pressed="true">当月</button>
        </div>
        <div class="hc-year-nav" role="group" aria-label="切换月份" data-year-nav hidden>
          <button type="button" class="hc-year-button" data-year-prev aria-label="上一月">←</button>
          <output class="hc-year-output" data-year-output>{initialYear} 年 {initialMonth} 月</output>
          <button type="button" class="hc-year-button" data-year-next aria-label="下一月">→</button>
        </div>
        <button type="button" class="hc-share-trigger" data-calendar-share-open aria-label="生成分享卡片" aria-haspopup="dialog" aria-controls="hc-share-dialog" hidden>
          <Icon name="sparkle" size={13} />分享卡片
        </button>
      </div>
    </div>

    <p class="hc-legend">
      <span><span class="hc-legend-flag is-holiday" aria-hidden="true">休</span>法定假期</span>
      <span><span class="hc-legend-flag is-work" aria-hidden="true">班</span>调休上班</span>
      <span><span class="hc-legend-today" aria-hidden="true"></span>今天</span>
      <span class="hc-legend-note">{firstYear}–{lastYear} 年安排来自国务院办公厅公告</span>
    </p>

    <div class="hc-months" data-months-year data-year={initialYear} set:html={renderMonths(initialYear, flags)} hidden />
    <div
      class="hc-months is-month"
      data-months-month
      data-year={initialYear}
      data-month={initialMonth}
      set:html={renderMonthView(initialYear, initialMonth, flags)}
    />
  </section>

  <div class="hc-columns">
    <section class="hc-panel hc-bento-wages" aria-labelledby="hc-wage-title">
      <div class="hc-panel-head">
        <h2 id="hc-wage-title">发薪倒计时</h2>
        <span class="hc-panel-meta mono">休息日顺延</span>
      </div>
      <div class="hc-pay-settings" data-pay-settings></div>
      <div data-wage-output set:html={renderWageRows(wageRows)} />
    </section>

    <section class="hc-panel hc-bento-holidays" aria-labelledby="hc-holiday-title">
      <div class="hc-panel-head">
        <h2 id="hc-holiday-title">假期倒计时</h2>
        <span class="hc-panel-meta mono">法定安排</span>
      </div>
      <div class="hc-holiday-scroll" data-holiday-output set:html={renderHolidayRows(holidayRows, currentYear)} />
    </section>
  </div>

  <section class="hc-panel hc-bento-stats" aria-labelledby="hc-stats-title">
    <div class="hc-panel-head">
      <h2 id="hc-stats-title">假期统计</h2>
      <div class="hc-year-nav" role="group" aria-label="切换假期统计年份" data-stats-nav hidden>
        <button type="button" class="hc-year-button" data-stats-prev aria-label="上一年假期统计">←</button>
        <output class="hc-year-output"><span data-stats-year>{initialStatsYear}</span> 年安排</output>
        <button type="button" class="hc-year-button" data-stats-next aria-label="下一年假期统计">→</button>
      </div>
    </div>
    <div data-stats-output set:html={renderHolidayStats(holidayStats)} />
  </section>

  <section class="hc-panel hc-bento-about" aria-labelledby="hc-about-title">
    <div class="hc-panel-head">
      <h2 id="hc-about-title">数据与规则</h2>
      <span class="hc-panel-meta mono">SOURCE</span>
    </div>
    <div class="hc-about-body prose">
      <p>放假与调休安排整理自国务院办公厅公告（via <a href="https://github.com/lanceliao/china-holiday-calender" rel="noopener noreferrer" target="_blank">china-holiday-calender</a>），农历、节气与节日来自 <a href="https://github.com/6tail/lunar-javascript" rel="noopener noreferrer" target="_blank">lunar-javascript</a>。</p>
      <ul class="hc-about-list">
        <li>发薪日若遇周末或法定节假日，自动顺延至下一工作日计算。</li>
        <li>发薪设置与分享海报均在浏览器本地保存与绘制，不会上传任何数据。</li>
      </ul>
    </div>
  </section>

  <CalendarShareDialog />
</div>

<style is:global>
  .holiday-calendar {
    --hc-holiday-strong: #be123c;
    --hc-holiday-on: #ffffff;
    --hc-holiday-bg: #fff1f2;
    --hc-holiday-border: #fecdd3;
    --hc-work-strong: #1e40af;
    --hc-work-on: #ffffff;
    --hc-work-bg: #eff6ff;
    --hc-work-border: #bfdbfe;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px;
    align-items: stretch;
  }

  /* Bento 网格分布（桌面 12 列） */
  .holiday-calendar .hc-bento-progress,
  .holiday-calendar .hc-bento-next-holiday,
  .holiday-calendar .hc-bento-next-wage {
    grid-column: span 4;
  }
  .holiday-calendar .hc-bento-calendar {
    grid-column: span 8;
  }
  .holiday-calendar .hc-columns {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  .holiday-calendar .hc-bento-holidays {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
  }
  /* 当月双栏并排时限制假期列表最大高度并内部滚动，使左右两栏高度自然齐平；全年视图下展开 */
  @media (min-width: 980px) {
    .holiday-calendar[data-active-view='month'] .hc-holiday-scroll {
      max-height: 316px;
      overflow-y: auto;
      padding-right: 4px;
      scrollbar-width: thin;
    }
  }
  .holiday-calendar .hc-bento-stats {
    grid-column: span 8;
  }
  .holiday-calendar .hc-bento-about {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
  }

  /* 全年视图：主日历横跨全宽 12 列（4×3 月份网格），两组倒计时自动并排为双栏 */
  .holiday-calendar[data-active-view='year'] .hc-bento-calendar,
  .holiday-calendar:has([data-view='year'][aria-pressed='true']) .hc-bento-calendar {
    grid-column: 1 / -1;
  }
  .holiday-calendar[data-active-view='year'] .hc-columns,
  .holiday-calendar:has([data-view='year'][aria-pressed='true']) .hc-columns {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  /* 通用扁平 Bento 卡片外观 */
  .holiday-calendar .hc-panel {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    padding: 20px 22px;
    min-width: 0;
  }
  .holiday-calendar .hc-bento-kpi {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 18px 20px;
  }

  .holiday-calendar .hc-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 14px;
  }
  .holiday-calendar .hc-panel-head.is-compact {
    margin-bottom: 10px;
  }
  .holiday-calendar .hc-calendar-title-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .holiday-calendar .hc-panel-head h2 {
    margin: 0;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--heading);
  }
  .holiday-calendar .hc-bento-kpi .hc-panel-head h2 {
    font-size: 13px;
    font-weight: 550;
    color: var(--muted);
  }
  .holiday-calendar .hc-panel-meta {
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  /* 顶部 KPI 概览卡数字与徽章 */
  .holiday-calendar .hc-kpi-body {
    display: grid;
    gap: 10px;
  }
  .holiday-calendar .hc-kpi-main {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
  }
  .holiday-calendar .hc-kpi-value {
    font-family: var(--sans);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--heading);
    font-variant-numeric: tabular-nums;
  }
  .holiday-calendar .hc-kpi-value.is-text {
    font-size: 26px;
    letter-spacing: -0.02em;
  }
  .holiday-calendar .hc-kpi-value.is-holiday {
    color: var(--hc-holiday-strong);
  }
  .holiday-calendar .hc-kpi-value small {
    margin-left: 3px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
  }
  .holiday-calendar .hc-kpi-badge {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    border-radius: 999px;
    background: var(--surface-soft);
    border: 1px solid var(--line);
    font-size: 11px;
    font-weight: 500;
    color: var(--muted);
    white-space: nowrap;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .holiday-calendar .hc-kpi-badge.is-holiday {
    background: var(--hc-holiday-bg);
    border-color: var(--hc-holiday-border);
    color: var(--hc-holiday-strong);
  }

  /* 进度条 */
  .holiday-calendar .hc-bar {
    display: block;
    position: relative;
    height: 6px;
    border-radius: 999px;
    background: var(--surface-soft);
    overflow: hidden;
  }
  .holiday-calendar .hc-bar-fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent-strong);
    transition: width 0.4s ease;
  }
  .holiday-calendar .hc-bar.is-holiday .hc-bar-fill {
    background: var(--hc-holiday-strong);
  }
  .holiday-calendar .hc-progress-text {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin: 0;
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* 工具栏与年份 / 视图切换（统一 30px 等高） */
  .holiday-calendar .hc-panel-controls {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }
  .holiday-calendar .hc-view-switch {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 30px;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface-soft);
  }
  .holiday-calendar .hc-view-switch[hidden] {
    display: none;
  }
  .holiday-calendar .hc-view-button {
    height: 24px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    font: 500 11.5px var(--sans);
    line-height: 24px;
    padding: 0 10px;
    cursor: pointer;
    transition: color 0.16s ease, background 0.16s ease;
  }
  .holiday-calendar .hc-view-button:hover {
    color: var(--heading);
  }
  .holiday-calendar .hc-view-button[aria-pressed='true'] {
    background: var(--surface);
    color: var(--heading);
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(9, 9, 11, 0.06);
  }
  .holiday-calendar .hc-year-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .holiday-calendar .hc-year-nav[hidden] {
    display: none;
  }
  .holiday-calendar .hc-year-button,
  .holiday-calendar .hc-year-reset {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
    transition: color 0.16s ease, border-color 0.16s ease, background 0.16s ease;
  }
  .holiday-calendar .hc-year-button {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    font-size: 12px;
  }
  .holiday-calendar .hc-year-reset {
    height: 30px;
    padding: 0 10px;
    font: 500 11.5px var(--sans);
    color: var(--text);
  }
  /* 在当月/今年时不占横向空间，同时保持 30px 盒高度 */
  .holiday-calendar .hc-year-reset[data-at-now='true'] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .holiday-calendar .hc-year-button:hover:not(:disabled),
  .holiday-calendar .hc-year-reset:hover {
    color: var(--heading);
    border-color: var(--line-strong);
    background: var(--surface-soft);
  }
  .holiday-calendar .hc-year-button:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .holiday-calendar .hc-year-output {
    min-width: 7.4em;
    text-align: center;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--heading);
    font-variant-numeric: tabular-nums;
  }

  /* 图例条 */
  .holiday-calendar .hc-legend {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin: 0 0 14px;
    padding: 8px 12px;
    border-radius: 10px;
    background: var(--surface-soft);
    font-size: 11.5px;
    color: var(--muted);
  }
  .holiday-calendar .hc-legend > span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .holiday-calendar .hc-legend-flag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    font-size: 9.5px;
    font-weight: 600;
    line-height: 1;
  }
  .holiday-calendar .hc-legend-flag.is-holiday {
    background: var(--hc-holiday-strong);
    color: var(--hc-holiday-on);
  }
  .holiday-calendar .hc-legend-flag.is-work {
    background: var(--hc-work-strong);
    color: var(--hc-work-on);
  }
  .holiday-calendar .hc-legend-today {
    width: 15px;
    height: 15px;
    border-radius: 4px;
    background: var(--surface);
    box-shadow: inset 0 0 0 2px var(--heading);
  }
  .holiday-calendar .hc-legend-note {
    margin-left: auto;
    font-size: 11px;
    color: var(--muted);
  }

  /* 全年月历容器（桌面严格 4×3 对称网格） */
  .holiday-calendar .hc-months[hidden] {
    display: none;
  }
  .holiday-calendar .hc-months {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .holiday-calendar .hc-month {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    padding: 12px 10px;
    min-width: 0;
  }
  .holiday-calendar .hc-month-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
  }
  .holiday-calendar .hc-month-name {
    margin: 0;
    font-family: var(--sans);
    font-size: 13.5px;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--heading);
    font-variant-numeric: tabular-nums;
  }
  .holiday-calendar .hc-month-tags {
    font-size: 10px;
    font-weight: 550;
    color: var(--hc-holiday-strong);
    background: var(--hc-holiday-bg);
    border: 1px solid var(--hc-holiday-border);
    padding: 1px 7px;
    border-radius: 999px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .holiday-calendar .hc-weekdays,
  .holiday-calendar .hc-days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }
  .holiday-calendar .hc-weekdays {
    margin-bottom: 4px;
    padding: 4px 0;
  }
  .holiday-calendar .hc-weekdays span {
    text-align: center;
    font-size: 10px;
    font-weight: 500;
    color: var(--muted);
  }
  .holiday-calendar .hc-days {
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 3px;
  }

  /* 正方形日期格：绝对定位内部栈，确保任意视口严格 1:1 */
  .holiday-calendar .hc-day {
    position: relative;
    aspect-ratio: 1 / 1;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
    border-radius: 6px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px #f1f2f4;
    transition: background 0.14s ease, box-shadow 0.14s ease;
  }
  .holiday-calendar .hc-day:not(.is-empty):hover {
    background: var(--surface-soft);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .holiday-calendar .hc-day.is-empty {
    background: transparent;
    box-shadow: none;
  }
  .holiday-calendar .hc-day > time {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2px 1px 1px;
    line-height: 1.15;
    max-width: 100%;
  }
  .holiday-calendar .hc-months:not(.is-month) .hc-day.is-holiday > time,
  .holiday-calendar .hc-months:not(.is-month) .hc-day.is-work > time {
    padding: 5px 3px 0 0;
  }
  .holiday-calendar .hc-day-num {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--heading);
    font-variant-numeric: tabular-nums;
  }
  .holiday-calendar .hc-day.is-weekend .hc-day-num {
    color: var(--muted);
  }
  .holiday-calendar .hc-day-lunar {
    max-width: 100%;
    padding: 0 1px;
    font-size: 7.5px;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .holiday-calendar .hc-day-note {
    display: none;
  }

  /* 假期 / 调休 / 今天状态 */
  .holiday-calendar .hc-day.is-holiday,
  .holiday-calendar .hc-day.is-holiday:hover {
    background: var(--hc-holiday-bg);
    box-shadow: inset 0 0 0 1px var(--hc-holiday-border);
  }
  .holiday-calendar .hc-day.is-holiday .hc-day-num,
