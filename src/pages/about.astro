---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config';
---
<BaseLayout title="关于" description={`你好，我是 ${site.author}。在这里写文章，做些小东西。`}>
  <div class="about-page">
    <div class="page-intro about-intro">
      <img src="/avatar.jpg" alt={site.author} class="about-avatar" width="64" height="64" loading="eager" decoding="async" />
      <h1>你好，我是 {site.author}<span class="title-dot">.</span></h1>
    </div>
    <div class="prose about-copy">
      <p>在这里写文章，做些小东西。</p>
      <div class="about-contact">
        <a href="/rss.xml" class="button button-outline"><Icon name="rss" size={16} /> 订阅 RSS</a>
      </div>
    </div>
  </div>
</BaseLayout>
