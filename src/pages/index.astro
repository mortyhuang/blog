---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPosts } from '../lib/posts';
import { featuredProjects } from '../data/projects';

const posts = await getPosts();
---
<BaseLayout>
<div class="home-page">
  <section id="articles" class="home-section" aria-labelledby="articles-title">
    <div class="section-heading">
      <div class="section-title"><h1 id="articles-title">文章</h1></div>
      <a class="small-link" href="/posts/">全部文章 <Icon name="arrow" size={14} /></a>
    </div>
    <div class="home-posts">{posts.map((post) => <PostRow post={post} />)}</div>
  </section>

  <section id="projects" class="home-section" aria-labelledby="projects-title">
    <div class="section-heading">
      <div class="section-title"><h2 id="projects-title">toys</h2></div>
      <a class="small-link" href="/toys/">全部 toys <Icon name="arrow" size={14} /></a>
    </div>
    <div class="project-previews">{featuredProjects.map((project) => <ProjectCard project={project} compact />)}</div>
  </section>
</div>
</BaseLayout>
